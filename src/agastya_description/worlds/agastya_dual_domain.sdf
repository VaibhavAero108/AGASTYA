<?xml version="1.0"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Copyright (C) 2026 Vaibhav (VaibhavAero108) -->
<!--
  AGASTYA dual-domain test pool.
    * Pool water volume: x -4..4, y -3..3, surface z = 0, floor z = -1.2.
      (The AgastyaDynamics plugin config in the URDF must match these.)
    * Deck / ground level: z = +0.10.
    * Landing pad: on the east deck at (5.5, 0); AGASTYA spawns on it.
  Water is a visual surface; buoyancy and hydrodynamic drag are computed by
  the AgastyaDynamics system for the vehicle.
-->
<sdf version="1.9">
  <world name="agastya_dual_domain">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.6 1</ambient>
      <background>0.62 0.76 0.92 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.55</ambient_light>
        <background_color>0.62 0.76 0.92</background_color>
        <camera_pose>9.0 2.6 2.3 0 0.36 -2.72</camera_pose>
        <camera_clip><near>0.05</near><far>300</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="CameraTracking" name="Camera Tracking"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="MarkerManager" name="Marker manager"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="SelectEntities" name="Select Entities"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">72</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">110</property><property type="double" key="width">290</property><property type="double" key="z">1</property><property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></gz-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot"><gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui></plugin>
      <plugin filename="EntityTree" name="Entity tree"><gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui></plugin>
      <plugin filename="ComponentInspector" name="Component inspector"><gz-gui><property type="string" key="state">docked_collapsed</property></gz-gui></plugin>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.25 -0.88</direction>
    </light>
    <light name="pool_fill" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 -0.6 0 0 0</pose>
      <diffuse>0.35 0.55 0.7 1</diffuse>
      <attenuation><range>8</range><constant>0.6</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- ===================== pool structure ===================== -->
    <model name="pool">
      <static>true</static>
      <link name="shell">
        <collision name="floor_c"><pose>0 0 -1.3 0 0 0</pose><geometry><box><size>8.4 6.4 0.2</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 -1.3 0 0 0</pose><geometry><box><size>8.4 6.4 0.2</size></box></geometry>
          <material><ambient>0.35 0.65 0.75 1</ambient><diffuse>0.35 0.65 0.75 1</diffuse></material></visual>
        <collision name="wall_e_c"><pose>4.1 0 -0.55 0 0 0</pose><geometry><box><size>0.2 6.4 1.3</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>4.1 0 -0.55 0 0 0</pose><geometry><box><size>0.2 6.4 1.3</size></box></geometry>
          <material><ambient>0.55 0.8 0.88 1</ambient><diffuse>0.55 0.8 0.88 1</diffuse></material></visual>
        <collision name="wall_w_c"><pose>-4.1 0 -0.55 0 0 0</pose><geometry><box><size>0.2 6.4 1.3</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-4.1 0 -0.55 0 0 0</pose><geometry><box><size>0.2 6.4 1.3</size></box></geometry>
          <material><ambient>0.55 0.8 0.88 1</ambient><diffuse>0.55 0.8 0.88 1</diffuse></material></visual>
        <collision name="wall_n_c"><pose>0 3.1 -0.55 0 0 0</pose><geometry><box><size>8.4 0.2 1.3</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0 3.1 -0.55 0 0 0</pose><geometry><box><size>8.4 0.2 1.3</size></box></geometry>
          <material><ambient>0.5 0.75 0.85 1</ambient><diffuse>0.5 0.75 0.85 1</diffuse></material></visual>
        <collision name="wall_s_c"><pose>0 -3.1 -0.55 0 0 0</pose><geometry><box><size>8.4 0.2 1.3</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0 -3.1 -0.55 0 0 0</pose><geometry><box><size>8.4 0.2 1.3</size></box></geometry>
          <material><ambient>0.5 0.75 0.85 1</ambient><diffuse>0.5 0.75 0.85 1</diffuse></material></visual>
        <!-- lane lines on the floor -->
        <visual name="lane_1"><pose>0 -1.5 -1.199 0 0 0</pose><geometry><box><size>7.0 0.15 0.002</size></box></geometry><material><ambient>0.05 0.1 0.3 1</ambient><diffuse>0.05 0.1 0.3 1</diffuse></material></visual>
        <visual name="lane_2"><pose>0 0 -1.199 0 0 0</pose><geometry><box><size>7.0 0.15 0.002</size></box></geometry><material><ambient>0.05 0.1 0.3 1</ambient><diffuse>0.05 0.1 0.3 1</diffuse></material></visual>
        <visual name="lane_3"><pose>0 1.5 -1.199 0 0 0</pose><geometry><box><size>7.0 0.15 0.002</size></box></geometry><material><ambient>0.05 0.1 0.3 1</ambient><diffuse>0.05 0.1 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- water surface (visual only, visible from above and below) -->
    <model name="water_surface">
      <static>true</static>
      <link name="surface">
        <visual name="surface">
          <pose>0 0 -0.002 0 0 0</pose>
          <geometry><box><size>8.0 6.0 0.004</size></box></geometry>
          <transparency>0.55</transparency>
          <cast_shadows>false</cast_shadows>
          <material><ambient>0.05 0.35 0.6 1</ambient><diffuse>0.05 0.35 0.6 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ===================== deck ===================== -->
    <model name="deck">
      <static>true</static>
      <link name="deck">
        <collision name="east_c"><pose>8.1 0 -0.1 0 0 0</pose><geometry><box><size>7.8 30 0.4</size></box></geometry></collision>
        <visual name="east_v"><pose>8.1 0 -0.1 0 0 0</pose><geometry><box><size>7.8 30 0.4</size></box></geometry><material><ambient>0.72 0.7 0.66 1</ambient><diffuse>0.72 0.7 0.66 1</diffuse></material></visual>
        <collision name="west_c"><pose>-8.1 0 -0.1 0 0 0</pose><geometry><box><size>7.8 30 0.4</size></box></geometry></collision>
        <visual name="west_v"><pose>-8.1 0 -0.1 0 0 0</pose><geometry><box><size>7.8 30 0.4</size></box></geometry><material><ambient>0.72 0.7 0.66 1</ambient><diffuse>0.72 0.7 0.66 1</diffuse></material></visual>
        <collision name="north_c"><pose>0 8.6 -0.1 0 0 0</pose><geometry><box><size>8.4 10.8 0.4</size></box></geometry></collision>
        <visual name="north_v"><pose>0 8.6 -0.1 0 0 0</pose><geometry><box><size>8.4 10.8 0.4</size></box></geometry><material><ambient>0.72 0.7 0.66 1</ambient><diffuse>0.72 0.7 0.66 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -8.6 -0.1 0 0 0</pose><geometry><box><size>8.4 10.8 0.4</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -8.6 -0.1 0 0 0</pose><geometry><box><size>8.4 10.8 0.4</size></box></geometry><material><ambient>0.72 0.7 0.66 1</ambient><diffuse>0.72 0.7 0.66 1</diffuse></material></visual>
      </link>
    </model>
    <model name="lawn">
      <static>true</static>
      <link name="lawn">
        <visual name="lawn"><pose>0 0 -0.31 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material><ambient>0.3 0.5 0.25 1</ambient><diffuse>0.3 0.5 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== landing pad (east deck) ===================== -->
    <model name="landing_pad">
      <static>true</static>
      <pose>5.5 0 0.115 0 0 0</pose>
      <link name="pad">
        <collision name="c"><geometry><box><size>1.2 1.2 0.03</size></box></geometry></collision>
        <visual name="base"><geometry><box><size>1.2 1.2 0.03</size></box></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material></visual>
        <visual name="ring"><pose>0 0 0.0155 0 0 0</pose><geometry><cylinder><radius>0.5</radius><length>0.001</length></cylinder></geometry><material><ambient>0.95 0.55 0.05 1</ambient><diffuse>0.95 0.55 0.05 1</diffuse></material></visual>
        <visual name="ring_in"><pose>0 0 0.016 0 0 0</pose><geometry><cylinder><radius>0.44</radius><length>0.001</length></cylinder></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material></visual>
        <visual name="h_l"><pose>0 0.15 0.0168 0 0 0</pose><geometry><box><size>0.45 0.07 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="h_r"><pose>0 -0.15 0.0168 0 0 0</pose><geometry><box><size>0.45 0.07 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="h_m"><pose>0 0 0.0168 0 0 0</pose><geometry><box><size>0.07 0.30 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== FPV landmarks ===================== -->
    <!-- underwater gate: 1.2 m wide, crossbar just below the surface, so the
         vehicle passes through it at the 0.2-0.6 m cruise depth -->
    <model name="underwater_gate">
      <static>true</static>
      <pose>-1.0 0 -1.2 0 0 0</pose>
      <link name="gate">
        <collision name="post_l_c"><pose>0 0.6 0.56 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.12</length></cylinder></geometry></collision>
        <visual name="post_l"><pose>0 0.6 0.56 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.12</length></cylinder></geometry><material><ambient>0.95 0.2 0.1 1</ambient><diffuse>0.95 0.2 0.1 1</diffuse></material></visual>
        <collision name="post_r_c"><pose>0 -0.6 0.56 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.12</length></cylinder></geometry></collision>
        <visual name="post_r"><pose>0 -0.6 0.56 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.12</length></cylinder></geometry><material><ambient>0.95 0.2 0.1 1</ambient><diffuse>0.95 0.2 0.1 1</diffuse></material></visual>
        <collision name="bar_c"><pose>0 0 1.12 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.28</length></cylinder></geometry></collision>
        <visual name="bar"><pose>0 0 1.12 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.28</length></cylinder></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="marker_red">
      <static>true</static><pose>-2.8 1.8 -1.2 0 0 0</pose>
      <link name="l"><collision name="c"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0.3 0 0 0</pose><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="marker_green">
      <static>true</static><pose>-2.8 -1.8 -1.2 0 0 0</pose>
      <link name="l"><collision name="c"><pose>0 0 0.25 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
        <visual name="v"><pose>0 0 0.25 0 0 0</pose><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual></link>
    </model>
    <model name="marker_buoy">
      <static>true</static><pose>1.5 -1.8 0 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
        <visual name="line"><pose>0 0 -0.6 0 0 0</pose><geometry><cylinder><radius>0.005</radius><length>1.2</length></cylinder></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link>
    </model>
    <model name="deck_cone_1">
      <static>true</static><pose>4.6 1.0 0.1 0 0 0</pose>
      <link name="l"><visual name="v"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry><material><ambient>1 0.4 0 1</ambient><diffuse>1 0.4 0 1</diffuse></material></visual></link>
    </model>
    <model name="deck_cone_2">
      <static>true</static><pose>4.6 -1.0 0.1 0 0 0</pose>
      <link name="l"><visual name="v"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry><material><ambient>1 0.4 0 1</ambient><diffuse>1 0.4 0 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
